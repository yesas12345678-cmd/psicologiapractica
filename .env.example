# Configuración de base de datos PostgreSQL
DATABASE_URL="postgresql://usuario:contraseña@host:puerto/nombre_bd?schema=public"

# Contraseña de administrador para el portal de redacción
ADMIN_PASSWORD="cambiame_por_una_contrasena_segura"

# URL base del sitio web (para SEO y generación de Sitemaps)
NEXT_PUBLIC_SITE_URL="https://psicologiapractica.tech"

# Configuración de Staging (establecer en 'true' para entornos de pruebas)
# Esto deshabilitará la indexación en motores de búsqueda (Google, Bing, etc.)
IS_STAGING="false"

# API Key de DeepSeek para generación diaria de artículos (si aplica)
DEEPSEEK_API_KEY="tu_api_key_aqui"
